module.exports = require('./scalajs.webpack.config');

const CustomConf = {
  module: {
    rules: [
      {
          test: /\.css$/,
          use: ['style-loader', 'css-loader']
      },
      {
          test: /\.(ttf|eot|woff|png|glb)$/,
          type: 'asset/resource'
      }
    ]
  }
};

Object.assign(module.exports, CustomConf);
